---
// The whole guest app: one static page. The table token comes from the URL at runtime (/t/<token>, or ?t=<token>),
// so the host only has to rewrite /t/* to this page (public/_redirects, vercel.json).
import '../styles/tokens.css';
import '../styles/guest.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#1f2657" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1a2050" media="(prefers-color-scheme: dark)" />
    <meta name="robots" content="noindex" />
    <title>Tip Dim</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700&family=Noto+Sans+Devanagari:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap"
    />
  </head>
  <body>
    <header class="top">
      <div class="who">
        <h1 id="restaurant"></h1>
        <p id="table" class="sub"></p>
      </div>
      <div class="head-actions">
        <button id="scan-btn" class="ghost" type="button"></button>
        <button id="lang" class="ghost" type="button"></button>
      </div>
    </header>
    <div id="filters" class="filters" hidden>
      <div class="searchrow">
        <input id="search" type="search" autocomplete="off" enterkeyhint="search" />
        <div id="layout" class="switch" role="radiogroup" hidden></div>
      </div>
      <nav id="cats" class="cats"></nav>
    </div>
    <main id="main"></main>
    <button id="bar" class="bar" type="button" hidden></button>

    <dialog id="cart" aria-labelledby="cart-title">
      <div class="sheet">
        <div class="sheet-head">
          <h2 id="cart-title"></h2>
          <button id="cart-close" class="ghost" type="button"></button>
        </div>
        <ul id="cart-lines" class="lines"></ul>
        <label class="note">
          <span id="note-label"></span>
          <textarea id="note" maxlength="200" rows="2"></textarea>
        </label>
        <p id="cart-error" class="error" role="alert" hidden></p>
        <div class="total"><span id="total-label"></span><strong id="total"></strong></div>
        <button id="send" class="primary" type="button"></button>
      </div>
    </dialog>

    <dialog id="item-sheet" aria-labelledby="sheet-title">
      <div class="sheet">
        <div class="sheet-head">
          <div>
            <h2 id="sheet-title"></h2>
            <p id="sheet-other" class="other"></p>
          </div>
          <button id="sheet-close" class="ghost" type="button"></button>
        </div>
        <div id="sheet-body" class="sheet"></div>
      </div>
    </dialog>

    <dialog id="scan" aria-labelledby="scan-title">
      <div class="sheet">
        <div class="sheet-head">
          <h2 id="scan-title"></h2>
          <button id="scan-close" class="ghost" type="button"></button>
        </div>
        <div class="viewfinder"><video id="scan-video" playsinline muted></video></div>
        <p id="scan-status" class="muted" role="status"></p>
      </div>
    </dialog>
  </body>
</html>

<script>
  import { createGuestApi, GuestApiError, type GuestError, type GuestItem, type GuestMenu } from '../lib/api';
  import { addOne, cartCount, cartTotal, newId, setQty, toLines, type CartLine } from '../lib/cart';
  import { makeT } from '../lib/i18n';
  import { filterMenu, LAYOUTS, type Layout } from '../lib/menuView';
  import type { Lang } from '../shared/numerals';

  const api = createGuestApi({
    url: import.meta.env.PUBLIC_SUPABASE_URL ?? '',
    anonKey: import.meta.env.PUBLIC_SUPABASE_ANON_KEY ?? '',
    fetch: (input, init) => fetch(input, init),
  });

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  // /m/<token> is the cafe's menu-only QR: the menu with photos, no table, no ordering.
  const menuToken = location.pathname.match(/^\/m\/([^/]+)/u)?.[1] ?? new URLSearchParams(location.search).get('m') ?? '';
  const menuOnly = menuToken !== '';
  const token = menuOnly
    ? menuToken
    : (location.pathname.match(/^\/t\/([^/]+)/u)?.[1] ?? new URLSearchParams(location.search).get('t') ?? '');

  // localStorage can be blocked (private mode); the page still works, it just forgets between visits.
  const store = {
    get: (k: string) => {
      try {
        return localStorage.getItem(k);
      } catch {
        return null;
      }
    },
    set: (k: string, v: string) => {
      try {
        localStorage.setItem(k, v);
      } catch {
        /* not kept */
      }
    },
  };
  // One session per table: the server ties a session to the table it first ordered from.
  const sessionKey = `tipdim.session.${token}`;
  const session = store.get(sessionKey) ?? newId();
  store.set(sessionKey, session);

  let lang: Lang = store.get('tipdim.lang') === 'ne' ? 'ne' : 'en';
  let menu: GuestMenu | null = null;
  let items = new Map<string, GuestItem>();
  let cart: CartLine[] = [];
  let view: 'loading' | 'menu' | 'sent' | 'home' | { error: GuestError } = 'loading';
  let query = '';
  let categoryId: string | null = null;
  let layout: Layout = LAYOUTS.find((l) => l === store.get('tipdim.layout')) ?? 'table';
  let sending = false;
  let sendError: GuestError | null = null;
  // A retried send reuses the same round id, so the kitchen never gets it twice.
  let pendingRound: string | null = null;

  function el<K extends keyof HTMLElementTagNameMap>(
    tag: K,
    props: Partial<HTMLElementTagNameMap[K]> & { aria?: Record<string, string> } = {},
    ...children: (Node | string | null)[]
  ) {
    const { aria, ...rest } = props;
    const node = Object.assign(document.createElement(tag), rest);
    for (const [k, v] of Object.entries(aria ?? {})) node.setAttribute(`aria-${k}`, v);
    node.append(...children.filter((c): c is Node | string => c !== null));
    return node;
  }

  function stepper(index: number, label: string, qty: number, tr: ReturnType<typeof makeT>) {
    const { t } = tr;
    return el(
      'div',
      { className: 'stepper' },
      el('button', {
        type: 'button',
        textContent: '−',
        onclick: () => update(setQty(cart, index, qty - 1)),
        aria: { label: t('less', { name: label }) },
      }),
      el('span', { textContent: tr.digits(qty), aria: { label: t('qty', { n: qty }) } }),
      el('button', {
        type: 'button',
        textContent: '+',
        onclick: () => update(setQty(cart, index, qty + 1)),
        aria: { label: t('more', { name: label }) },
      }),
    );
  }

  function addControl(item: GuestItem, sizeId: string | null, label: string, tr: ReturnType<typeof makeT>) {
    if (!item.in_stock) return el('span', { className: 'badge', textContent: tr.t('soldOut') });
    const index = cart.findIndex((l) => l.itemId === item.id && l.sizeId === sizeId);
    const line = cart[index];
    if (line) return stepper(index, label, line.qty, tr);
    return el('button', {
      type: 'button',
      className: 'add',
      textContent: tr.t('add'),
      onclick: () => update(addOne(cart, item.id, sizeId)),
      aria: { label: tr.t('addLabel', { name: label }) },
    });
  }

  function render() {
    const tr = makeT(lang);
    document.documentElement.lang = lang;
    $('lang').textContent = tr.t('switchLang');
    $('lang').setAttribute('aria-label', tr.t('switchLangLabel'));
    const main = $('main');
    const cats = $('cats');
    main.replaceChildren();
    cats.replaceChildren();
    $('bar').hidden = true;
    $('scan-btn').textContent = tr.t('scan');
    $('scan-btn').setAttribute('aria-label', tr.t('scanTitle'));
    const search = $<HTMLInputElement>('search');
    const total = menu?.items.length ?? 0;
    search.placeholder = menuOnly ? tr.t(total === 1 ? 'searchNOne' : 'searchN', { n: total }) : tr.t('search');
    search.setAttribute('aria-label', tr.t('search'));
    $('filters').hidden = !(view === 'menu' && menu);
    $('layout').hidden = !menuOnly;
    if (!menu) $('restaurant').textContent = 'Tip Dim';

    if (menu) {
      $('restaurant').textContent = (lang === 'ne' ? menu.restaurant.name_ne : null) ?? menu.restaurant.name;
      const sold = menu.items.filter((i) => !i.in_stock).length;
      $('table').textContent = menu.table
        ? tr.t('table', { label: menu.table.label })
        : tr.t(total === 1 ? 'itemCountOne' : 'itemCount', { n: total }) + (sold ? ` · ${tr.t('soldOutCount', { n: sold })}` : '');
      document.title = $('restaurant').textContent ?? 'Tip Dim';
    }

    if (view === 'loading') {
      main.append(el('p', { className: 'state muted', role: 'status', textContent: tr.t('loading') }));
      return;
    }
    if (typeof view === 'object') {
      const code = view.error;
      main.append(
        el(
          'div',
          { className: 'state' },
          el('p', { role: 'alert', textContent: tr.error(code) }),
          code === 'network' || code === 'unknown'
            ? el('button', { type: 'button', className: 'primary', textContent: tr.t('retry'), onclick: () => void load() })
            : null,
        ),
      );
      return;
    }
    if (view === 'home') {
      renderHome(tr);
      return;
    }
    if (view === 'sent' && menu) {
      main.append(
        el(
          'div',
          { className: 'state sent', role: 'status' },
          el('h2', { textContent: tr.t('sentTitle') }),
          el('p', { textContent: menu.needs_accept ? tr.t('sentNeedsAccept') : tr.t('sentAccepted') }),
          // Online payment waits on the digital-payments decision; guests pay at the counter for now.
          el('p', { className: 'muted', textContent: tr.t('payAtCounter') }),
          el('button', {
            type: 'button',
            className: 'primary',
            textContent: tr.t('orderMore'),
            onclick: () => {
              view = 'menu';
              render();
            },
          }),
        ),
      );
      return;
    }
    if (!menu) return;

    cats.setAttribute('aria-label', tr.t('categories'));
    if (menuOnly) {
      renderBrowse(tr);
      return;
    }
    const q = query.trim().toLowerCase();
    const shown = menu.items.filter(
      (i) => !q || [i.name_en, i.name_ne, i.description_en, i.description_ne].some((x) => x?.toLowerCase().includes(q)),
    );
    const known = new Set(menu.categories.map((c) => c.id));
    const groups = [
      ...menu.categories.map((c) => ({ id: c.id, title: tr.name(c), list: shown.filter((i) => i.category_id === c.id) })),
      { id: 'other', title: tr.t('other'), list: shown.filter((i) => !i.category_id || !known.has(i.category_id)) },
    ];
    if (!shown.length) main.append(el('p', { className: 'state muted', textContent: tr.t('noMatch', { q: query.trim() }) }));
    for (const g of groups) {
      if (!g.list.length) continue;
      cats.append(el('a', { href: `#c-${g.id}`, className: 'chip', textContent: g.title }));
      const section = el('section', { id: `c-${g.id}` }, el('h2', { textContent: g.title }));
      for (const item of g.list) {
        const name = tr.name(item);
        const desc = lang === 'ne' ? (item.description_ne ?? item.description_en) : (item.description_en ?? item.description_ne);
        const card = el(
          'article',
          { className: item.in_stock ? 'item' : 'item out' },
          el(
            'div',
            { className: 'item-head' },
            item.photo ? el('img', { className: 'photo', src: item.photo, alt: '', loading: 'lazy', width: 64, height: 64 }) : null,
            el('div', { className: 'item-text' }, el('h3', { textContent: name }), desc ? el('p', { className: 'muted', textContent: desc }) : null),
            item.sizes.length ? null : el('div', { className: 'item-end' }, el('span', { className: 'price', textContent: tr.money(item.price_paisa) }), menuOnly ? null : addControl(item, null, name, tr)),
          ),
        );
        for (const size of item.sizes) {
          const label = `${name} · ${tr.name(size)}`;
          card.append(
            el(
              'div',
              { className: 'size' },
              el('span', { textContent: tr.name(size) }),
              el('div', { className: 'item-end' }, el('span', { className: 'price', textContent: tr.money(size.price_paisa) }), menuOnly ? null : addControl(item, size.id, label, tr)),
            ),
          );
        }
        section.append(card);
      }
      main.append(section);
    }

    const n = menuOnly ? 0 : cartCount(cart);
    if (n) {
      const bar = $('bar');
      bar.hidden = false;
      bar.replaceChildren(
        el('span', { textContent: `${tr.t('viewOrder')} · ${tr.t('items', { n })}` }),
        el('strong', { textContent: tr.money(cartTotal(cart, items)) }),
      );
    }
    renderCart(tr);
  }

  const ICONS: Record<Layout, string> = {
    table: '<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 10h18M3 15h18M9 10v10"/></svg>',
    list: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 6h13M8 12h13M8 18h13M3.5 6h.01M3.5 12h.01M3.5 18h.01"/></svg>',
    grid: '<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="7.5" height="7.5" rx="1.5"/><rect x="13.5" y="3" width="7.5" height="7.5" rx="1.5"/><rect x="3" y="13.5" width="7.5" height="7.5" rx="1.5"/><rect x="13.5" y="13.5" width="7.5" height="7.5" rx="1.5"/></svg>',
  };
  const LAYOUT_LABEL = { table: 'viewTable', list: 'viewList', grid: 'viewGrid' } as const;

  // Rebuilding the controls drops keyboard focus; hand it back to the same control.
  function refocus(selector: string) {
    document.querySelector<HTMLElement>(selector)?.focus();
  }

  function thumb(item: GuestItem, name: string, cls = '') {
    const box = el('span', { className: `thumb ${cls}`.trim() }, name.charAt(0).toUpperCase());
    if (item.photo) {
      const img = el('img', { src: item.photo, alt: '', loading: 'lazy' });
      img.addEventListener('error', () => img.remove());
      box.append(img);
    }
    return box;
  }

  const soldTag = (tr: ReturnType<typeof makeT>) => el('span', { className: 'tag-sold', textContent: tr.t('soldOut') });
  const priced = (tr: ReturnType<typeof makeT>, label: string, paisa: number, sign = '') =>
    el('span', { className: 'pill' }, `${label} ${sign}`, el('span', { className: 'mono', textContent: tr.money(paisa) }));
  const count = (tr: ReturnType<typeof makeT>, key: 'sizeCount' | 'addonCount', n: number) =>
    tr.t(n === 1 ? (`${key}One` as 'sizeCountOne') : key, { n });

  // The menu-only page: the app's Menu tab, view only. Table (default), list or grid; category chips; A to Z.
  function renderBrowse(tr: ReturnType<typeof makeT>) {
    const m = menu;
    if (!m) return;
    const main = $('main');
    const cats = $('cats');
    const list = filterMenu(m.items, { lang, query, categoryId, name: (i) => tr.name(i) });

    const chip = (id: string | null, label: string) =>
      el('button', {
        type: 'button',
        className: 'chip',
        textContent: label,
        onclick: () => {
          categoryId = id;
          render();
          refocus(`[data-cat="${id ?? ''}"]`);
        },
        aria: { pressed: String(categoryId === id) },
      });
    const chips = [chip(null, tr.t('all')), ...m.categories.map((c) => chip(c.id, tr.name(c)))];
    chips.forEach((c, i) => (c.dataset.cat = i ? (m.categories[i - 1]?.id ?? '') : ''));
    cats.append(...chips);

    $('layout').replaceChildren(
      ...LAYOUTS.map((l) => {
        const b = el('button', {
          type: 'button',
          role: 'radio',
          onclick: () => {
            layout = l;
            store.set('tipdim.layout', l);
            render();
            refocus(`[data-layout="${l}"]`);
          },
          aria: { checked: String(layout === l), label: tr.t(LAYOUT_LABEL[l]) },
        });
        b.dataset.layout = l;
        b.innerHTML = ICONS[l];
        return b;
      }),
    );

    if (!list.length) {
      main.append(el('p', { className: 'state muted', textContent: m.items.length ? tr.t('noMatch', { q: query.trim() }) : tr.t('emptyMenu') }));
      return;
    }
    const catName = new Map(m.categories.map((c) => [c.id, tr.name(c)]));

    if (layout === 'list') {
      main.append(
        el(
          'ul',
          { className: 'rows' },
          ...list.map((i) => {
            const name = tr.name(i);
            const meta = el('span', { className: 'meta' }, el('span', { className: 'mono', textContent: tr.money(i.price_paisa) }));
            if (i.sizes.length) meta.append(`· ${count(tr, 'sizeCount', i.sizes.length)}`);
            if (i.addons?.length) meta.append(`· ${count(tr, 'addonCount', i.addons.length)}`);
            const btn = el(
              'button',
              { type: 'button', className: i.in_stock ? 'rowbtn' : 'rowbtn out', aria: { label: tr.t('details', { name }) } },
              thumb(i, name), el('span', { className: 'text' }, el('span', { textContent: name }), meta),
              i.in_stock ? null : el('span', { className: 'soldtxt', textContent: tr.t('soldOut') }),
            );
            btn.dataset.id = i.id;
            return el('li', {}, btn);
          }),
        ),
      );
      return;
    }

    if (layout === 'grid') {
      main.append(
        el(
          'ul',
          { className: 'grid' },
          ...list.map((i) => {
            const name = tr.name(i);
            const extra = [i.sizes.length ? count(tr, 'sizeCount', i.sizes.length) : '', i.addons?.length ? count(tr, 'addonCount', i.addons.length) : '']
              .filter(Boolean)
              .join(' · ');
            const tile = thumb(i, name, 'fill');
            if (!i.in_stock) tile.append(soldTag(tr));
            const btn = el(
              'button',
              { type: 'button', className: i.in_stock ? 'card' : 'card out', aria: { label: tr.t('details', { name }) } },
              el('span', { className: 'body' }, tile, el('span', { className: 'info' }, el('b', { textContent: name }), el('span', { className: 'mono', textContent: tr.money(i.price_paisa) }), extra ? el('small', { textContent: extra }) : null)),
            );
            btn.dataset.id = i.id;
            return el('li', {}, btn);
          }),
        ),
      );
      return;
    }

    const hasSizes = list.some((i) => i.sizes.length > 0);
    const hasAddons = list.some((i) => i.addons?.length);
    const extraCols = Number(hasSizes) + Number(hasAddons);
    const th = (cls: string, key: 'colName' | 'colPrice' | 'colSizes' | 'colAddons') => el('th', { className: cls, scope: 'col', textContent: tr.t(key) });
    const pills = (cells: Node[]) => (cells.length ? el('div', { className: 'cell pills' }, ...cells) : el('div', { className: 'cell muted', textContent: '—' }));
    const table = el(
      'table',
      { className: 'tbl' },
      el('thead', {}, el('tr', {}, th('c-name', 'colName'), th(extraCols ? 'c-price' : 'c-price fill', 'colPrice'), hasSizes ? th('', 'colSizes') : null, hasAddons ? th('', 'colAddons') : null)),
      el(
        'tbody',
        {},
        ...list.map((i) => {
          const name = tr.name(i);
          const cat = i.category_id ? catName.get(i.category_id) : '';
          const row = el(
            'tr',
            { className: i.in_stock ? '' : 'out' },
            el(
              'td',
              { className: 'c-name' },
              el(
                'button',
                { type: 'button', className: 'namebtn cell', aria: { label: tr.t('details', { name }) } },
                thumb(i, name, 'sm'),
                el('span', { className: 'nametext' }, el('b', { textContent: name }), cat ? el('small', { textContent: cat }) : null, i.in_stock ? null : soldTag(tr)),
              ),
            ),
            el('td', { className: 'c-price' }, el('div', { className: 'cell mono', textContent: tr.money(i.price_paisa) })),
            hasSizes ? el('td', {}, pills(i.sizes.map((z) => priced(tr, tr.name(z), z.price_paisa)))) : null,
            hasAddons ? el('td', {}, pills((i.addons ?? []).map((a) => (a.price_paisa ? priced(tr, tr.name(a), a.price_paisa, '+') : el('span', { className: 'pill', textContent: tr.name(a) }))))) : null,
          );
          row.dataset.id = i.id;
          return row;
        }),
      ),
    );
    table.style.minWidth = `calc(var(--menu-name) + var(--menu-price) + ${extraCols} * var(--menu-wide))`;
    main.append(el('div', { className: 'tbl-wrap' }, table));
  }

  function openSheet(item: GuestItem) {
    const tr = makeT(lang);
    const name = tr.name(item);
    const other = lang === 'ne' ? item.name_en : item.name_ne;
    $('sheet-title').textContent = name;
    $('sheet-other').textContent = other && other !== name ? other : '';
    $('sheet-other').hidden = !$('sheet-other').textContent;
    $('sheet-close').textContent = tr.t('close');
    const section = (title: string, rows: Node[]) =>
      el('div', { className: 'detail' }, el('h3', { textContent: title }), ...rows);
    const line = (label: string, value: Node) => el('div', {}, el('span', { textContent: label }), value);
    const money = (paisa: number, sign = '') => el('span', { className: 'mono', textContent: sign + tr.money(paisa) });
    const addons = item.addons ?? [];
    const photo = item.photo ? el('div', { className: 'photo-big' }, el('img', { src: item.photo, alt: '' })) : null;
    photo?.querySelector('img')?.addEventListener('error', () => photo.remove());
    $('sheet-body').replaceChildren(
      ...[
        photo,
        el('div', { className: 'pricerow' }, el('span', { className: 'mono big', textContent: tr.money(item.price_paisa) }), item.in_stock ? null : el('span', { className: 'badge', textContent: tr.t('soldOut') })),
        item.sizes.length ? section(tr.t('sizes'), item.sizes.map((z) => line(tr.name(z), money(z.price_paisa)))) : null,
        addons.length ? section(tr.t('addons'), addons.map((a) => line(tr.name(a), a.price_paisa ? money(a.price_paisa, '+') : el('span', { className: 'muted', textContent: tr.t('free') })))) : null,
        item.sizes.length || addons.length ? null : el('p', { className: 'muted', textContent: tr.t('onlyOne') }),
      ].filter((n): n is HTMLElement => n !== null),
    );
    ($('item-sheet') as HTMLDialogElement).showModal();
  }

  function renderCart(tr: ReturnType<typeof makeT>) {
    $('cart-title').textContent = tr.t('yourOrder');
    $('cart-close').textContent = tr.t('close');
    $('note-label').textContent = tr.t('note');
    ($('note') as HTMLTextAreaElement).placeholder = tr.t('notePlaceholder');
    $('total-label').textContent = tr.t('total');
    $('total').textContent = tr.money(cartTotal(cart, items));
    const send = $('send') as HTMLButtonElement;
    send.textContent = sending ? tr.t('sending') : tr.t('send');
    send.disabled = sending || cart.length === 0;
    const err = $('cart-error');
    err.hidden = !sendError;
    err.textContent = sendError ? tr.error(sendError) : '';

    const lines = $('cart-lines');
    lines.replaceChildren();
    if (!cart.length) lines.append(el('li', { className: 'muted', textContent: tr.t('emptyCart') }));
    cart.forEach((l, i) => {
      const item = items.get(l.itemId);
      if (!item) return;
      const size = item.sizes.find((s) => s.id === l.sizeId);
      const label = size ? `${tr.name(item)} · ${tr.name(size)}` : tr.name(item);
      lines.append(el('li', {}, el('span', { textContent: label }), stepper(i, label, l.qty, tr)));
    });
  }

  function update(next: CartLine[]) {
    // Every render rebuilds the list, so keep keyboard and screen-reader focus on the same control
    // (an "Add" that became a stepper hands focus to its "+").
    const label = document.activeElement?.getAttribute('aria-label') ?? '';
    const name = menu ? label.replace(makeT(lang).t('addLabel', { name: '' }).trim(), '').trim() : '';
    cart = next;
    pendingRound = null;
    sendError = null;
    render();
    const scope = ($('cart') as HTMLDialogElement).open ? $('cart') : document;
    const by = (l: string) => scope.querySelector<HTMLElement>(`[aria-label="${CSS.escape(l)}"]`);
    (by(label) ?? by(makeT(lang).t('more', { name })) ?? (scope === document ? null : $('cart-close')))?.focus();
  }

  async function load() {
    view = 'loading';
    render();
    if (!token) {
      view = 'home';
      return render();
    }
    try {
      menu = menuOnly ? await api.publicMenu(token) : await api.menu(token);
      items = new Map(menu.items.map((i) => [i.id, i]));
      store.set('tipdim.last', location.pathname);
      store.set('tipdim.last.name', menu.restaurant.name);
      // Drop anything that ran out since it was added.
      cart = cart.filter((l) => items.get(l.itemId)?.in_stock);
      view = 'menu';
    } catch (e) {
      view = { error: e instanceof GuestApiError ? e.code : 'unknown' };
    }
    render();
  }

  async function send() {
    if (sending || !cart.length) return;
    sending = true;
    sendError = null;
    pendingRound ??= newId();
    render();
    try {
      await api.place(token, { session, order: newId(), round: pendingRound }, toLines(cart, ($('note') as HTMLTextAreaElement).value, newId));
      cart = [];
      pendingRound = null;
      ($('note') as HTMLTextAreaElement).value = '';
      ($('cart') as HTMLDialogElement).close();
      view = 'sent';
    } catch (e) {
      sendError = e instanceof GuestApiError ? e.code : 'unknown';
      if (sendError === 'unavailable') void load();
    }
    sending = false;
    render();
  }

  $('lang').addEventListener('click', () => {
    lang = lang === 'ne' ? 'en' : 'ne';
    store.set('tipdim.lang', lang);
    render();
  });
  $('main').addEventListener('click', (e) => {
    const id = (e.target as HTMLElement).closest<HTMLElement>('[data-id]')?.dataset.id;
    const item = id ? items.get(id) : undefined;
    if (menuOnly && item) openSheet(item);
  });
  const sheet = $('item-sheet') as HTMLDialogElement;
  $('sheet-close').addEventListener('click', () => sheet.close());
  // A tap on the dimmed area (the dialog itself, outside its sheet) closes it.
  sheet.addEventListener('click', (e) => {
    if (e.target === sheet) sheet.close();
  });
  $('bar').addEventListener('click', () => ($('cart') as HTMLDialogElement).showModal());
  $('cart-close').addEventListener('click', () => ($('cart') as HTMLDialogElement).close());
  $('send').addEventListener('click', () => void send());

  // A QR (or pasted link) is only trusted if it is a Tip Dim table or menu path on this same address.
  function pathFrom(text: string): string | null {
    const raw = text.trim();
    let path = raw;
    try {
      const u = new URL(raw);
      if (u.host !== location.host) return null;
      path = u.pathname;
    } catch {
      /* not a full link: maybe just /m/<token> */
    }
    return path.match(/^\/(t|m)\/[A-Za-z0-9_-]{8,}\/?$/u) ? path.replace(/\/$/u, '') : null;
  }

  function renderHome(tr: ReturnType<typeof makeT>) {
    const main = $('main');
    const input = el('input', { type: 'url', id: 'link', placeholder: tr.t('linkPlaceholder'), autocomplete: 'off' });
    input.setAttribute('aria-label', tr.t('orPaste'));
    const err = el('p', { className: 'error', role: 'alert' });
    err.hidden = true;
    const open = () => {
      const path = pathFrom(input.value);
      if (!path) {
        err.textContent = tr.t('scanBad');
        err.hidden = false;
        return;
      }
      location.assign(path);
    };
    const last = store.get('tipdim.last');
    main.append(
      el(
        'div',
        { className: 'state home' },
        el('h2', { textContent: tr.t('homeTitle') }),
        el('p', { className: 'muted', textContent: tr.t('homeBody') }),
        el('button', { type: 'button', className: 'primary', textContent: tr.t('scanTitle'), onclick: () => void openScan() }),
        last && pathFrom(last)
          ? el('button', {
              type: 'button',
              className: 'ghost wide',
              textContent: tr.t('lastMenu', { name: store.get('tipdim.last.name') ?? 'Tip Dim' }),
              onclick: () => location.assign(last),
            })
          : null,
        el('p', { className: 'muted', textContent: tr.t('orPaste') }),
        el('form', { className: 'paste', onsubmit: (e: Event) => { e.preventDefault(); open(); } }, input, el('button', { type: 'submit', className: 'primary', textContent: tr.t('open') })),
        err,
      ),
    );
  }

  // Camera scanning: the browser's own detector where it exists, jsQR (loaded only now) everywhere else.
  let stream: MediaStream | null = null;
  let scanning = false;
  const dialog = () => $('scan') as HTMLDialogElement;

  function stopScan() {
    scanning = false;
    stream?.getTracks().forEach((t) => t.stop());
    stream = null;
    ($('scan-video') as HTMLVideoElement).srcObject = null;
    if (dialog().open) dialog().close();
  }

  async function openScan() {
    const tr = makeT(lang);
    $('scan-title').textContent = tr.t('scanTitle');
    $('scan-close').textContent = tr.t('close');
    $('scan-status').textContent = tr.t('scanStarting');
    if (!dialog().open) dialog().showModal();
    if (!navigator.mediaDevices?.getUserMedia) {
      $('scan-status').textContent = tr.t('scanUnsupported');
      return;
    }
    try {
      stream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: { ideal: 'environment' } }, audio: false });
    } catch {
      $('scan-status').textContent = tr.t('scanDenied');
      return;
    }
    const video = $('scan-video') as HTMLVideoElement;
    video.srcObject = stream;
    await video.play().catch(() => undefined);
    $('scan-status').textContent = tr.t('scanHint');
    scanning = true;
    const Detector = (window as unknown as { BarcodeDetector?: new (o: { formats: string[] }) => { detect: (v: HTMLVideoElement) => Promise<{ rawValue: string }[]> } }).BarcodeDetector;
    const detector = Detector ? new Detector({ formats: ['qr_code'] }) : null;
    const jsQR = detector ? null : (await import('jsqr')).default;
    const canvas = document.createElement('canvas');
    const ctx = canvas.getContext('2d', { willReadFrequently: true });
    const tick = async () => {
      if (!scanning) return;
      let text: string | null = null;
      if (video.readyState >= 2 && video.videoWidth) {
        if (detector) {
          text = (await detector.detect(video).catch(() => []))[0]?.rawValue ?? null;
        } else if (jsQR && ctx) {
          canvas.width = video.videoWidth;
          canvas.height = video.videoHeight;
          ctx.drawImage(video, 0, 0);
          const img = ctx.getImageData(0, 0, canvas.width, canvas.height);
          text = jsQR(img.data, img.width, img.height)?.data ?? null;
        }
      }
      if (text) {
        const path = pathFrom(text);
        if (path) {
          stopScan();
          location.assign(path);
          return;
        }
        $('scan-status').textContent = tr.t('scanBad');
      }
      setTimeout(() => void tick(), 250);
    };
    void tick();
  }

  $('scan-btn').addEventListener('click', () => void openScan());
  $('scan-close').addEventListener('click', stopScan);
  dialog().addEventListener('close', () => {
    if (scanning || stream) stopScan();
  });
  $('search').addEventListener('input', (e) => {
    query = (e.target as HTMLInputElement).value;
    render();
  });

  void load();
</script>
